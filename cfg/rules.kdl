    window-rule {
        geometry-corner-radius 20 // Set every window radius to 20
        clip-to-geometry true
    }

    window-rule {
      match app-id="steam"
      match app-id="discord"
      open-maximized true
      open-on-output "HDMI-A-1"
    }

    window-rule {
      match app-id="brave-browser"
      match app-id="dota2"
      open-on-output "DP-1"

    }

    layer-rule {
        match namespace="^noctalia-wallpaper*"
        place-within-backdrop true
    }

    window-rule {
        match app-id="Spotify"
        opacity 0.85
        background-effect {
            blur true
        }

    }

    window-rule {
        match app-id="code-oss"
        opacity 0.95
        open-maximized true
        background-effect {
            blur true
        }
    }
